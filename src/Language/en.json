  "about": {
    "title": "The intelligent phone assistant",
    "subtitle": "Are you familiar with the stressful daily routine of telephone calls?",
    "desc": "Ringing phones, missed calls, stressed employees – it doesn't have to be this way. MrBot is your smart phone assistant that automatically answers calls, forwards messages, and coordinates appointments – friendly, reliable, and available 24/7."
  },
  "works": {
    "heading": "How MrBot Works",
    "items": [
      {
        "title": "Customer Calls",
        "description": "MrBot answers every call politely – even after work hours or when your team is busy."
      },
      {
        "title": "Intelligent Conversation Management",
        "description": "The AI assistant understands concerns, answers frequently asked questions, and gathers all important information – all in compliance with GDPR."
      },
      {
        "title": "Forwarding & Notification",
        "description": "Important calls or messages are automatically forwarded to you or your team – via email, SMS, or chat. Appointments are entered and managed in your existing CRM system."
      },
      {
        "title": "External Service Providers",
        "description": "External service providers (hosting, AI, telephony) are used under data processing agreements pursuant to Art. 28 GDPR. Any data transfer to third countries is carried out only with appropriate safeguards under Art. 44 et seq. GDPR."
      }
    ]
  },

